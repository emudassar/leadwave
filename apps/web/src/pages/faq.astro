---
import Base from '@/layouts/Base.astro';
import Faq from '@/components/Faq.astro';
import { SIGNUP_URL } from '@/lib';
---

<Base
  title="FAQ — LeadWave"
  description="Will it get my Page restricted? What is the 24-hour window? Does the Follow Gate really verify a follow? Straight answers, including the limitations."
>
  <section class="px-5 pb-10 pt-16 text-center">
    <p class="eyebrow text-faint" data-reveal>Questions</p>
    <h1 class="display mx-auto mt-3 max-w-3xl text-[clamp(2.4rem,7vw,4.2rem)]" data-reveal>
      Common questions,<br />common-sense answers.
    </h1>
    <p class="mx-auto mt-5 max-w-lg text-[15px] leading-relaxed text-body" data-reveal>
      Including the two where the honest answer is a limitation. You would rather
      know now than after you have built something on it.
    </p>
  </section>

  <section class="px-5 pb-20">
    <div class="mx-auto max-w-3xl">
      <Faq />
    </div>
  </section>

  <section class="bg-sand px-5 py-16 text-center">
    <h2 class="display mx-auto max-w-2xl text-[clamp(1.8rem,5vw,2.8rem)]" data-reveal>
      Still wondering something?
    </h2>
    <p class="mx-auto mt-4 max-w-md text-[14.5px] leading-relaxed text-body" data-reveal>
      The free plan is the fastest way to find out. It takes a minute and costs
      nothing.
    </p>
    <a href={SIGNUP_URL} class="btn btn-primary mt-6 px-7 py-3.5 text-[15px]">Start free</a>
  </section>
</Base>
