---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { SIGNUP_URL } from '@/lib';

const all = (await getCollection('usecases')).sort((a, b) => a.data.order - b.data.order);

const groups = [
  {
    title: 'What it does',
    lead: 'Each capability, and the case for using it.',
    entries: all,
  },
];
---

<Base
  title="Use cases — LeadWave"
  description="Comment-to-DM, keyword auto-replies, lead capture, Follow Gate, carousels, AI replies — and how they are set up for stores, restaurants, salons, coaches and agencies."
>
  <section class="px-5 pb-12 pt-16 text-center">
    <p class="eyebrow text-faint" data-reveal>Use cases</p>
    <h1 class="display mx-auto mt-3 max-w-3xl text-[clamp(2.4rem,7vw,4.2rem)]" data-reveal>
      What people actually<br />use it for.
    </h1>
    <p class="mx-auto mt-5 max-w-lg text-[15px] leading-relaxed text-body" data-reveal>
      Each of these is one automation and about a minute of setup. Most businesses
      run three.
    </p>
  </section>

  {
    groups.map((group) => (
      <section class="px-5 pb-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="display text-[clamp(1.6rem,4vw,2.4rem)]" data-reveal>
            {group.title}
          </h2>
          <p class="mt-2 text-[14px] text-muted" data-reveal>
            {group.lead}
          </p>

          <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {group.entries.map((entry, i) => (
              <a
                href={`/use-cases/${entry.id}`}
                class="group flex flex-col rounded-2xl border border-ink/8 bg-white p-6 transition-all hover:border-ink hover:shadow-lg"
                data-reveal
                data-reveal-delay={String((i % 3) * 70)}
              >
                <p class="eyebrow text-brand-700">{entry.data.eyebrow}</p>
                <h3 class="mt-2.5 text-[18px] font-semibold leading-snug tracking-tight">
                  {entry.data.heading}
                </h3>
                <p class="mt-2.5 flex-1 text-[13.5px] leading-relaxed text-muted">
                  {entry.data.description}
                </p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-semibold">
                  Read it
                  <svg
                    viewBox="0 0 16 16"
                    class="size-3.5 transition-transform group-hover:translate-x-1"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 8h10M9 4l4 4-4 4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="messenger-gradient px-5 py-16 text-center text-white">
    <h2 class="display mx-auto max-w-2xl text-[clamp(1.9rem,5.5vw,3.2rem)]" data-reveal>
      Pick one. Set it up.<br />See what happens.
    </h2>
    <a href={SIGNUP_URL} class="btn btn-light mt-7 px-7 py-3.5 text-[15px]">Start free</a>
  </section>
</Base>
