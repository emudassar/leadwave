---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { SIGNUP_URL } from '@/lib';

export async function getStaticPaths() {
  const entries = await getCollection('audiences');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'audiences'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const GROUP_LABEL = {
  creator: 'Creators, sellers & marketers',
  local: 'Local & service businesses',
} as const;

// Siblings from the same group, so the page is not a dead end.
const related = (await getCollection('audiences'))
  .filter((other) => other.id !== entry.id && other.data.group === entry.data.group)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  about: 'Facebook Messenger automation',
  publisher: { '@type': 'Organization', name: 'LeadWave' },
});
---

<Base title={entry.data.title} description={entry.data.description} schema={schema}>
  <article>
    <header class="border-b border-ink/8 px-5 pb-12 pt-14">
      <div class="shell-narrow">
        <nav class="flex flex-wrap items-center gap-1.5 text-[12.5px] text-faint" aria-label="Breadcrumb">
          <a href="/for" class="transition-colors hover:text-ink">Built for</a>
          <span>/</span>
          <span>{GROUP_LABEL[entry.data.group]}</span>
          <span>/</span>
          <span class="text-body">{entry.data.eyebrow}</span>
        </nav>

        <h1 class="display mt-4 text-[clamp(2rem,5.5vw,3.3rem)]" data-reveal>
          {entry.data.heading}
        </h1>
        <p class="lede mt-5 max-w-2xl" data-reveal>{entry.data.description}</p>

        <ul class="mt-8 grid gap-2.5 sm:grid-cols-2" data-reveal>
          {
            entry.data.highlights.map((point) => (
              <li class="flex items-start gap-2.5 text-[14px] leading-relaxed text-body">
                <span class="mt-1 flex size-4 shrink-0 items-center justify-center rounded-full bg-brand-600">
                  <svg viewBox="0 0 20 20" class="size-2.5 text-white" fill="currentColor" aria-hidden="true">
                    <path d="M8.3 13.4 4.9 10l-1.4 1.4 4.8 4.8 9-9L15.9 5.8Z" />
                  </svg>
                </span>
                {point}
              </li>
            ))
          }
        </ul>

        <a href={SIGNUP_URL} class="btn btn-primary mt-9 px-7 py-3.5 text-[15px]">
          Set it up free
        </a>
        <p class="mt-3 text-[12.5px] text-muted">
          No card · 1,000 messages a month, permanently
        </p>
      </div>
    </header>

    <div class="px-5 py-14">
      <div
        class="shell-narrow [&_em]:font-mono [&_em]:text-[14px] [&_em]:not-italic [&_em]:text-brand-700 [&_h2]:display [&_h2]:mb-3.5 [&_h2]:mt-11 [&_h2]:text-[clamp(1.35rem,3vw,1.85rem)] [&_h2:first-child]:mt-0 [&_li]:mb-2 [&_li]:text-[15.5px] [&_li]:leading-[1.7] [&_li]:text-body [&_p]:mb-5 [&_p]:text-[16px] [&_p]:leading-[1.75] [&_p]:text-body [&_strong]:font-semibold [&_strong]:text-ink [&_ul]:mb-6 [&_ul]:list-disc [&_ul]:pl-5"
      >
        <Content />
      </div>
    </div>
  </article>

  {
    related.length ? (
      <section class="band band-mist">
        <div class="shell">
          <p class="eyebrow text-brand-700">Also in {GROUP_LABEL[entry.data.group].toLowerCase()}</p>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {related.map((other) => (
              <a
                href={`/for/${other.id}`}
                class="panel p-5 transition-all hover:-translate-y-0.5 hover:border-brand-600/35"
              >
                <p class="eyebrow text-brand-700">{other.data.eyebrow}</p>
                <p class="mt-2 text-[15.5px] font-semibold leading-snug text-ink">
                  {other.data.heading}
                </p>
                <p class="mt-2 line-clamp-3 text-[13px] leading-relaxed text-body">
                  {other.data.description}
                </p>
              </a>
            ))}
          </div>
          <a
            href="/for"
            class="mt-7 inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-brand-700"
          >
            See every kind of business
            <svg viewBox="0 0 16 16" class="size-3.5" fill="none" aria-hidden="true">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </section>
    ) : null
  }

  <section class="relative overflow-hidden bg-brand-700 px-5 py-16 text-center text-white">
    <div class="shell-narrow relative">
      <h2 class="display text-[clamp(1.8rem,5vw,3rem)]" style="color:#ffffff">
        About a minute to set up.<br />Free to try.
      </h2>
      <a href={SIGNUP_URL} class="btn btn-light mt-7 px-7 py-3.5 text-[15px]">Start free</a>
    </div>
  </section>
</Base>
