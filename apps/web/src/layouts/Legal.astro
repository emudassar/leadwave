---
/** Shared chrome for the legal pages: readable measure, one type scale. */
import Base from '@/layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="px-5 py-16">
    <div class="mx-auto max-w-2xl">
      <h1 class="display text-[clamp(2rem,6vw,3.2rem)]">{title}</h1>
      <p class="mt-3 text-[13px] text-faint">Last updated {updated}</p>

      <div
        class="mt-10 [&_a]:text-brand-700 [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mb-3 [&_h2]:mt-9 [&_h2]:text-[19px] [&_h2]:font-semibold [&_h2]:tracking-tight [&_h3]:mb-2 [&_h3]:mt-6 [&_h3]:text-[15px] [&_h3]:font-semibold [&_li]:mb-1.5 [&_li]:text-[14.5px] [&_li]:leading-relaxed [&_li]:text-body [&_p]:mb-4 [&_p]:text-[14.5px] [&_p]:leading-[1.72] [&_p]:text-body [&_strong]:font-semibold [&_strong]:text-ink [&_ul]:mb-5 [&_ul]:list-disc [&_ul]:pl-5"
      >
        <slot />
      </div>

      <p class="mt-12 rounded-xl border border-ink/8 bg-sand p-4 text-[12.5px] leading-relaxed text-muted">
        This page is written to be understood, not to be unreadable. It is not
        legal advice, and if you are deploying LeadWave yourself you should have a
        lawyer review it against the jurisdictions you actually operate in before
        you publish it.
      </p>
    </div>
  </article>
</Base>
