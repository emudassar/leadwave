---
/**
 * The dashboard, drawn rather than screenshotted.
 *
 * A picture of an admin panel is the single most persuasive thing a SaaS site
 * can show — people want to know what they will actually be looking at every
 * morning. Built in markup instead of a PNG so it stays sharp on any display,
 * reflows on a phone instead of becoming an unreadable thumbnail, and cannot
 * drift out of date the way an exported image does.
 *
 * The numbers are the seeded demo workspace's real ones.
 */

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const nav = [
  { label: 'Home', active: true },
  { label: 'Automations' },
  { label: 'Inbox', badge: '9' },
  { label: 'Contacts' },
  { label: 'LeadWave AI' },
  { label: 'Link in bio' },
  { label: 'Settings' },
];

const stats = [
  { label: 'Triggers', sub: 'last 7 days', value: '68', tone: 'brand' },
  { label: 'Link clicks', sub: 'last 7 days', value: '247', tone: 'sky' },
  { label: 'Leads captured', sub: 'last 7 days', value: '30', tone: 'green' },
  { label: 'Waiting on you', sub: 'unread', value: '9', tone: 'amber' },
];

const toneClass: Record<string, string> = {
  brand: 'bg-brand-600/12 text-brand-700',
  sky: 'bg-sky-500/12 text-sky-700',
  green: 'bg-emerald-500/12 text-emerald-700',
  amber: 'bg-amber-accent/15 text-amber-700',
};

const rows = [
  { name: 'Comment "PRICE" → send the menu', meta: 'Comment · fired 2 hours ago', triggers: '68', people: '44', ctr: '65%', bar: 65, live: true },
  { name: 'DM "SHIP" → shipping answer', meta: 'Keyword · fired 5 hours ago', triggers: '38', people: '21', ctr: '55%', bar: 55, live: true },
  { name: 'Story reply → best sellers', meta: 'Story reply · paused', triggers: '24', people: '9', ctr: '38%', bar: 38, live: false },
];
---

<div class={`overflow-hidden rounded-[var(--radius-panel)] border border-ink/8 bg-white shadow-[0_2px_6px_rgb(18_26_31/0.05),0_40px_80px_-40px_rgb(18_26_31/0.35)] ${className}`}>
  <!-- Window chrome, so it reads as an application and not a web page -->
  <div class="flex items-center gap-2 border-b border-ink/7 bg-slate-tint px-4 py-2.5">
    <span class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="size-2.5 rounded-full bg-[#28c840]"></span>
    </span>
    <span
      class="mx-auto rounded-full bg-white px-3 py-0.5 font-mono text-[10.5px] text-faint ring-1 ring-ink/6"
    >
      app.leadwave.co/home
    </span>
  </div>

  <div class="grid grid-cols-[132px_minmax(0,1fr)] sm:grid-cols-[172px_minmax(0,1fr)]">
    <!-- ── Rail ──────────────────────────────────────────────────────── -->
    <aside class="border-r border-ink/7 bg-[#fbfdfc] p-2.5 sm:p-3">
      <div class="flex items-center gap-1.5 px-1 pb-3">
        <span class="brand-gradient flex size-5 items-center justify-center rounded-md">
          <svg viewBox="0 0 32 32" class="size-3.5" aria-hidden="true">
            <path
              d="M6 20c3-5 5-5 8 0s5 5 8 0"
              stroke="#fff"
              stroke-width="3"
              stroke-linecap="round"
              fill="none"></path>
          </svg>
        </span>
        <span class="display text-[13px]">LeadWave</span>
      </div>

      <div class="mb-3 flex items-center gap-1.5 rounded-lg border border-ink/8 bg-white p-1.5">
        <span class="size-5 shrink-0 rounded-full bg-gradient-to-br from-brand-400 to-brand-700"></span>
        <span class="min-w-0">
          <span class="block truncate text-[9.5px] font-semibold leading-tight text-ink">
            Demo Store
          </span>
          <span class="block text-[8px] leading-tight text-faint">Connected</span>
        </span>
      </div>

      <ul class="space-y-0.5">
        {
          nav.map((item) => (
            <li
              class={`flex items-center gap-1.5 rounded-lg px-1.5 py-1.5 text-[10.5px] font-medium ${
                item.active ? 'bg-brand-600/10 text-brand-700' : 'text-muted'
              }`}
            >
              <span
                class={`size-3 shrink-0 rounded-[3px] ${item.active ? 'bg-brand-600/35' : 'bg-ink/10'}`}
              />
              <span class="truncate">{item.label}</span>
              {item.badge ? (
                <span class="ml-auto rounded-full bg-brand-600 px-1 text-[8px] font-bold text-white">
                  {item.badge}
                </span>
              ) : null}
            </li>
          ))
        }
      </ul>

      <div class="mt-3 rounded-lg border border-brand-600/20 bg-brand-50 p-2">
        <p class="text-[9px] font-semibold leading-tight text-brand-800">AI credits</p>
        <p class="mt-1 font-mono text-[11px] leading-none text-brand-700">787 left</p>
        <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-brand-600/15">
          <div class="h-full w-[21%] rounded-full bg-brand-600"></div>
        </div>
      </div>
    </aside>

    <!-- ── Main ──────────────────────────────────────────────────────── -->
    <div class="min-w-0 p-3 sm:p-4">
      <p class="display-tight text-[15px] sm:text-[18px]">Good evening, Mudassar.</p>
      <p class="mt-1 text-[10px] text-muted sm:text-[11px]">
        LeadWave handled 68 conversations for you this week.
      </p>

      <!-- Stat tiles -->
      <div class="mt-3 grid grid-cols-4 gap-1.5 sm:gap-2">
        {
          stats.map((stat) => (
            <div class="rounded-lg border border-ink/8 bg-white p-1.5 sm:p-2">
              <span class={`flex size-4 items-center justify-center rounded ${toneClass[stat.tone]}`}>
                <span class="size-1.5 rounded-[1px] bg-current" />
              </span>
              <p class="mt-1.5 font-[family-name:var(--font-display)] text-[16px] leading-none text-ink sm:text-[20px]">
                {stat.value}
              </p>
              <p class="mt-1 truncate text-[8.5px] font-medium leading-tight text-ink sm:text-[9.5px]">
                {stat.label}
              </p>
              <p class="truncate text-[7.5px] leading-tight text-faint sm:text-[8.5px]">{stat.sub}</p>
            </div>
          ))
        }
      </div>

      <!-- What's working -->
      <div class="mt-2.5 rounded-lg border border-ink/8 bg-white">
        <div class="flex items-center justify-between border-b border-ink/7 px-2.5 py-2">
          <p class="text-[10.5px] font-semibold text-ink">What's working</p>
          <p class="text-[9px] text-faint">unique clickers ÷ triggers</p>
        </div>
        <ul class="divide-y divide-ink/6">
          {
            rows.map((row) => (
              <li class="flex items-center gap-2 px-2.5 py-2">
                <span class="flex size-5 shrink-0 items-center justify-center rounded bg-brand-600/12">
                  <span class="size-1.5 rounded-full bg-brand-600" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-center gap-1.5">
                    <span class="truncate text-[10px] font-medium text-ink">{row.name}</span>
                    <span
                      class={`shrink-0 rounded-full px-1.5 text-[7.5px] font-semibold ${
                        row.live
                          ? 'bg-emerald-500/14 text-emerald-700'
                          : 'bg-amber-accent/18 text-amber-700'
                      }`}
                    >
                      {row.live ? 'Live' : 'Paused'}
                    </span>
                  </span>
                  <span class="block truncate text-[8.5px] text-faint">{row.meta}</span>
                </span>
                <span class="hidden shrink-0 items-center gap-3 sm:flex">
                  <span class="text-right">
                    <span class="block font-mono text-[10px] leading-none text-ink">
                      {row.triggers}
                    </span>
                    <span class="block text-[7.5px] text-faint">triggers</span>
                  </span>
                  <span class="text-right">
                    <span class="block font-mono text-[10px] leading-none text-ink">
                      {row.people}
                    </span>
                    <span class="block text-[7.5px] text-faint">people</span>
                  </span>
                  <span class="w-12">
                    <span class="block font-mono text-[10px] leading-none text-brand-700">
                      {row.ctr}
                    </span>
                    <span class="mt-0.5 block h-1 overflow-hidden rounded-full bg-ink/8">
                      <span
                        class="block h-full rounded-full bg-brand-600"
                        style={`width:${row.bar}%`}
                      />
                    </span>
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Bottom row: setup + AI receipts -->
      <div class="mt-2.5 grid gap-2 sm:grid-cols-2">
        <div class="rounded-lg border border-ink/8 bg-white p-2.5">
          <p class="text-[10px] font-semibold text-ink">Setup</p>
          <ul class="mt-1.5 space-y-1">
            {
              ['Connect a Facebook Page', 'Publish your first automation', 'Get your first trigger'].map(
                (label) => (
                  <li class="flex items-center gap-1.5 text-[9px] text-muted">
                    <span class="flex size-2.5 items-center justify-center rounded-full bg-emerald-500">
                      <svg viewBox="0 0 20 20" class="size-1.5 text-white" fill="currentColor">
                        <path d="M8.3 13.4 4.9 10l-1.4 1.4 4.8 4.8 9-9L15.9 5.8Z" />
                      </svg>
                    </span>
                    <span class="truncate line-through decoration-ink/25">{label}</span>
                  </li>
                ),
              )
            }
          </ul>
        </div>

        <div class="rounded-lg border border-ink/8 bg-white p-2.5">
          <p class="text-[10px] font-semibold text-ink">AI stayed quiet</p>
          <p class="mt-1 font-[family-name:var(--font-display)] text-[18px] leading-none text-ink">
            13
          </p>
          <p class="text-[8.5px] text-faint">decisions not to reply — all free</p>
          <div class="mt-1.5 space-y-1">
            {
              [
                ['Did not know the answer', 55],
                ['You replied first', 30],
                ['Window had closed', 15],
              ].map(([label, w]) => (
                <div>
                  <p class="text-[8px] text-muted">{label}</p>
                  <span class="mt-0.5 block h-1 overflow-hidden rounded-full bg-ink/8">
                    <span class="block h-full rounded-full bg-brand-500/60" style={`width:${w}%`} />
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
