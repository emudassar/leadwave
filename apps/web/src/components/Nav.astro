---
import { PRODUCT_LINKS, SIGNUP_URL } from '@/lib';
---

<header class="sticky top-0 z-50 border-b border-ink/7 bg-white/88 backdrop-blur-lg">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
    <a href="/" class="flex items-center gap-2.5" aria-label="LeadWave home">
      <span class="brand-gradient flex size-7 items-center justify-center rounded-lg">
        <svg viewBox="0 0 32 32" class="size-5" aria-hidden="true">
          <path
            d="M6 20c3-5 5-5 8 0s5 5 8 0"
            stroke="#fff"
            stroke-width="2.8"
            stroke-linecap="round"
            fill="none"></path>
        </svg>
      </span>
      <span class="display text-[20px]">LeadWave</span>
    </a>

    <ul class="ml-4 hidden items-center gap-6 md:flex">
      {
        PRODUCT_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[13.5px] font-medium text-body transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <a href={SIGNUP_URL} class="hidden text-[13.5px] font-medium text-body hover:text-ink sm:block">
        Sign in
      </a>
      <a href={SIGNUP_URL} class="btn btn-primary text-[13.5px]">
        Start free
        <svg viewBox="0 0 16 16" class="size-3.5" fill="none" aria-hidden="true">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <button
        type="button"
        class="md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" class="size-6" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </nav>

  <div class="hidden border-t border-ink/8 px-5 py-3 md:hidden" data-menu-panel>
    <ul class="space-y-1">
      {
        PRODUCT_LINKS.map((link) => (
          <li>
            <a href={link.href} class="block py-2 text-[15px] font-medium">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
