---
import { SIGNUP_URL } from '@/lib';

const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#features', label: 'Features' },
      { href: '/pricing', label: 'Pricing' },
      { href: '/faq', label: 'FAQ' },
      { href: '/use-cases', label: 'Use cases' },
    ],
  },
  {
    title: 'Use cases',
    links: [
      { href: '/use-cases/comment-to-dm', label: 'Comment to DM' },
      { href: '/use-cases/lead-capture', label: 'Lead capture' },
      { href: '/use-cases/follow-gate', label: 'Follow Gate' },
      { href: '/use-cases/link-in-bio', label: 'Link in bio' },
      { href: '/use-cases/ai-replies', label: 'AI replies' },
    ],
  },
  {
    title: 'Built for',
    links: [
      { href: '/for/creators', label: 'Creators' },
      { href: '/for/ecommerce', label: 'Online stores' },
      { href: '/for/coaches', label: 'Coaches' },
      { href: '/for/agencies', label: 'Agencies' },
      { href: '/for/restaurants', label: 'Restaurants' },
      { href: '/for', label: 'Every business →' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
      { href: '/data-deletion', label: 'Data deletion' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/8 bg-sand">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.4fr)_repeat(4,minmax(0,1fr))]">
      <div>
        <a href="/" class="flex items-center gap-2.5">
          <span class="brand-gradient flex size-7 items-center justify-center rounded-lg">
            <svg viewBox="0 0 32 32" class="size-5" aria-hidden="true">
              <path
                d="M6 20c3-5 5-5 8 0s5 5 8 0"
                stroke="#fff"
                stroke-width="2.8"
                stroke-linecap="round"
                fill="none"></path>
            </svg>
          </span>
          <span class="display text-[20px]">LeadWave</span>
        </a>
        <p class="mt-3 max-w-xs text-[13px] leading-relaxed text-muted">
          Facebook Messenger automation that answers every comment, captures the
          lead and counts every click — without you being at your desk.
        </p>
        <a href={SIGNUP_URL} class="btn btn-primary mt-5 text-[13px]">Start free</a>
      </div>

      {
        columns.map((column) => (
          <div>
            <p class="eyebrow text-faint">{column.title}</p>
            <ul class="mt-3 space-y-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[13px] text-body transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-ink/8 pt-6 text-[12px] text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year} LeadWave. Built on Meta's official Graph API. ·
        <a href="mailto:leadwaveonline@gmail.com" class="hover:text-ink">leadwaveonline@gmail.com</a>
      </p>
      <p>
        Not affiliated with, endorsed by or sponsored by Meta Platforms, Inc.
        Facebook and Messenger are trademarks of Meta Platforms, Inc.
      </p>
    </div>
  </div>
</footer>
