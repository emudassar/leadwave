# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# Public origin of the API (used for OAuth callbacks + webhook URLs)
API_URL=http://localhost:4000
# Public origin of the marketing site (Astro)
WEB_URL=http://localhost:4321
# Public origin of the dashboard SPA
APP_URL=http://localhost:5173
# Origin that serves short links, e.g. https://lw.link
SHORTLINK_URL=http://localhost:4000

# ─── Database / queues ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://leadwave:leadwave@localhost:5432/leadwave?schema=public
REDIS_URL=redis://localhost:6379
# true on a host with no free tier for a separate worker service — runs the
# queue workers inside the API process instead of a standalone worker.ts
RUN_EMBEDDED_WORKER=false

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Session cookie signing key.            openssl rand -hex 32
SESSION_SECRET=replace-me-with-64-hex-chars
# AES-256-GCM key for Page access tokens at rest. MUST be 64 hex chars (32 bytes).
ENCRYPTION_KEY=replace-me-with-64-hex-chars

# ─── Google OAuth (sign-in) ──────────────────────────────────────────────────
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: ${API_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google Sheets integration (Business plan) ───────────────────────────────
# Separate OAuth client with the spreadsheets scope.
# Authorised redirect URI: ${API_URL}/api/v1/integrations/google-sheets/callback
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# ─── Meta / Facebook app ─────────────────────────────────────────────────────
# developers.facebook.com -> your app -> Settings -> Basic
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id (Use cases -> Customise -> Configurations)
META_LOGIN_CONFIG_ID=
# Any random string; paste the same value into the Webhooks "Verify token" field.
META_WEBHOOK_VERIFY_TOKEN=replace-me
META_GRAPH_VERSION=v21.0
# Redirect URI: ${API_URL}/api/v1/meta/auth/fb/callback

# ─── Gemini (LeadWave AI + the free marketing tools) ─────────────────────────
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_STANDARD=gemini-2.5-flash

# ─── Billing: Paddle (primary) ───────────────────────────────────────────────
BILLING_PROVIDER=paddle
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_GROWTH_MONTHLY=
PADDLE_PRICE_GROWTH_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=

# ─── Billing: Lemon Squeezy (swap-in alternative) ────────────────────────────
# Set BILLING_PROVIDER=lemonsqueezy to use these instead.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_GROWTH_MONTHLY=
LEMONSQUEEZY_VARIANT_GROWTH_YEARLY=
LEMONSQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY=

# ─── Uploads (carousel images, bio avatars) ──────────────────────────────────
# "local" writes to apps/api/uploads. "s3" uses any S3-compatible store (R2, B2, MinIO).
UPLOAD_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Ops ─────────────────────────────────────────────────────────────────────
# Comma-separated emails that unlock /admin
ADMIN_EMAILS=
LOG_LEVEL=info
